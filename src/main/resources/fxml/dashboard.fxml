<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mn.edu.internship.hotel.controller.DashboardController"
            prefWidth="1100" prefHeight="700" styleClass="page-background">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="topbar">
            <padding><Insets top="18" right="24" bottom="18" left="24"/></padding>
            <VBox HBox.hgrow="ALWAYS">
                <Label fx:id="welcomeLabel" styleClass="heading"/>
                <Label fx:id="roleLabel" styleClass="muted-text"/>
            </VBox>
            <Button fx:id="logoutButton" text="Гарах" onAction="#handleLogout"
                    styleClass="secondary-button"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="18" styleClass="content">
            <VBox spacing="4">
                <Label text="Өрөөний удирдлага" styleClass="title"/>
                <Label text="Өрөөний төлөвийг харах, хайх болон шүүх" styleClass="subtitle"/>
            </VBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="roomNumberFilter" promptText="Өрөөний дугаар" prefWidth="180"/>
                <ComboBox fx:id="statusFilter" prefWidth="180"/>
                <Button text="Хайх" onAction="#handleSearch" styleClass="primary-button"/>
                <Button text="Шинэчлэх" onAction="#handleRefresh" styleClass="secondary-button"/>
                <Button text="+ Өрөө нэмэх" onAction="#handleAddRoom" styleClass="primary-button"/>
                <Button text="+ Захиалга / үйлчлүүлэгч" onAction="#handleAddReservationBetter" styleClass="primary-button"/>
            </HBox>
            <Label fx:id="roomMessageLabel" styleClass="muted-text"/>
            <TableView fx:id="roomsTable" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="Өрөөний мэдээлэл алга байна." styleClass="muted-text"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="roomNumberColumn" text="Дугаар" prefWidth="120"/>
                    <TableColumn fx:id="floorColumn" text="Давхар" prefWidth="100"/>
                    <TableColumn fx:id="typeColumn" text="Төрөл" prefWidth="150"/>
                    <TableColumn fx:id="capacityColumn" text="Багтаамж" prefWidth="110"/>
                    <TableColumn fx:id="priceColumn" text="Үнэ / шөнө" prefWidth="150"/>
                    <TableColumn fx:id="statusColumn" text="Төлөв" prefWidth="150"/>
                </columns>
            </TableView>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Захиалгууд" styleClass="heading"/>
                <Button text="Шинэчлэх" onAction="#handleRefreshReservations" styleClass="secondary-button"/>
                <Button text="Буудалд оруулах" onAction="#handleCheckIn" styleClass="primary-button"/>
                <Button text="Буудлаас гаргах" onAction="#handleCheckOut" styleClass="secondary-button"/>
                <Button text="Төлбөр" onAction="#handlePayment" styleClass="secondary-button"/>
            </HBox>
            <TableView fx:id="reservationsTable" prefHeight="180">
                <columns>
                    <TableColumn fx:id="reservationCodeColumn" text="Код" prefWidth="130"/>
                    <TableColumn fx:id="reservationCustomerColumn" text="Үйлчлүүлэгч" prefWidth="180"/>
                    <TableColumn fx:id="reservationRoomColumn" text="Өрөө" prefWidth="90"/>
                    <TableColumn fx:id="reservationDatesColumn" text="Огноо" prefWidth="220"/>
                    <TableColumn fx:id="reservationStatusColumn" text="Төлөв" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
