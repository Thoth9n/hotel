<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mn.edu.internship.hotel.controller.DashboardController"
            prefWidth="1100" prefHeight="700" styleClass="page-background">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="topbar">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>
            <VBox HBox.hgrow="ALWAYS">
                <Label fx:id="welcomeLabel" styleClass="heading"/>
                <Label fx:id="roleLabel" styleClass="muted-text"/>
            </VBox>
            <Button fx:id="logoutButton" text="Гарах" onAction="#handleLogout"
                    styleClass="secondary-button"/>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="12">
            <Label text="Dashboard" styleClass="title"/>
            <Label text="Дараагийн issue-ээр өрөөний төлөвийн картууд нэмэгдэнэ."
                   styleClass="subtitle"/>
        </VBox>
    </center>
</BorderPane>

