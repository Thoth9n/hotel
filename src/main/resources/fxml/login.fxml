<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mn.edu.internship.hotel.controller.LoginController"
            prefWidth="1000" prefHeight="650" styleClass="page-background">
    <center>
        <VBox alignment="CENTER" maxWidth="420" spacing="16" styleClass="card">
            <padding>
                <Insets top="36" right="36" bottom="36" left="36"/>
            </padding>
            <Label text="Зочид буудлын систем" styleClass="title"/>
            <Label text="Ажилтны нэвтрэх хэсэг" styleClass="subtitle"/>
            <TextField fx:id="usernameField" promptText="Нэвтрэх нэр"
                       onAction="#handleLogin" maxWidth="340"/>
            <PasswordField fx:id="passwordField" promptText="Нууц үг"
                           onAction="#handleLogin" maxWidth="340"/>
            <Label fx:id="errorLabel" wrapText="true" styleClass="error-text"
                   maxWidth="340"/>
            <Button fx:id="loginButton" text="Нэвтрэх" onAction="#handleLogin"
                    defaultButton="true" maxWidth="340" styleClass="primary-button"/>
        </VBox>
    </center>
</BorderPane>

